# Copy to .env (gitignored). Real secrets live in the team vault and are rotated by developers (F-013).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev uses the Postgres container (`task db:up`), reached on its published host port.
# Leave DATABASE_URL unset instead to fall back to local SQLite (no Docker needed).
DATABASE_URL=postgres://gahk:gahk@localhost:5432/gahk
# Running the app itself in Docker instead (`task dev`)? docker-compose.yml's `web` service
# overrides this to the in-network hostname (postgres:5432) — this value is only for `task dev:local`.

# Celery uses PostgreSQL for both its persistent work queue and task results. Leave this unset to
# use DATABASE_URL. Set it only when the worker should use a dedicated PostgreSQL database.
# CELERY_DATABASE_URL=postgres://gahk:gahk@localhost:5432/gahk

# Secrets surfaced by features, kept out of source (F-013):
WIFI_PASSWORD=
GOOGLE_CALENDAR_USER=
GOOGLE_CALENDAR_PASSWORD=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# SMTP_PORT=587        # 587 = STARTTLS (default); 465 = implicit TLS. Django forbids both at once.

# Dev leaves EMAIL_BACKEND unset -> the console backend prints mails to the runserver terminal
# instead of sending. Uncomment to send for real (every test resident then gets a real mail):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#
# Sender addresses. one.com refuses any From that SMTP_USER is not itself or an alias of, so these
# must be aliased onto SMTP_USER in the one.com control panel or nothing is delivered. Check with:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend python manage.py sendtestemail you@…
# DEFAULT_FROM_EMAIL=autosvar@gahk.dk       # welcome, password-reset and admissions mails
# OELKAELDER_FROM_EMAIL=bierkeller@gahk.dk  # ølkælder debt warnings
# INDSTILLING_EMAIL=indstillingen@gahk.dk   # recipient of admissions notifications, not a sender

# Cloudflare Turnstile keys (can be obtained at https://www.cloudflare.com/products/turnstile/)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# Visit-counter IP hashing (F-002/F-011/F-013): server-side secret for HMAC-SHA256 of visitor IPs.
VISIT_COUNTER_HMAC_KEY=change-me

# Max size of an image a resident may attach to an opslag on opslagstavlen. Its own knob rather than
# sharing the CMS cap: an ops change for the CMS must not silently change what residents may post.
# NOTICE_IMAGE_MAX_MB=5

# --- Media storage (object storage: MinIO locally, Hetzner Object Storage in prod) --------------
#
# NOT REQUIRED FOR LOCAL DEV — config/settings.py already defaults every one of these (bucket,
# credentials, endpoint, addressing style, the two AWS_* checksum flags below) to the MinIO
# container docker-compose.yml runs, so S3 works on a fresh checkout with no app/.env at all. There
# is no local-disk fallback either way: STORAGES["default"] is unconditionally
# core.storage.MediaS3Storage, so a WRONG value here is a loud S3 error on first upload, not a quiet
# switch to MEDIA_ROOT on local disk. Uncomment only to point at a bucket other than the default:
# S3_BUCKET=gahk-s3
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ADDRESSING_STYLE=path      # MinIO has no wildcard cert for virtual-hosted-style requests
#
# Only needed if S3_ENDPOINT_URL is not reachable from wherever a BROWSER runs (task dev:local's
# isn't affected — it already is). Presigned URLs are signed against a host, and the request that
# follows one must hit that same host, so leave this unset unless something 403s with a signature
# mismatch. See docker-compose.yml's `web` service, which is the one case that needs it.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
#
# Running the app itself in Docker instead (`task dev`)? docker-compose.yml's `web` service
# overrides S3_ENDPOINT_URL to http://minio:9000 (the in-network hostname) — the value above is
# only for `task dev:local`, talking to MinIO's published port.
#
# Do NOT point these at a real bucket just to try it out and then run the test suite: several tests
# upload files and several assert that deleting a row deletes the file. tests/conftest.py forces
# filesystem storage for exactly that reason, but do not lean on it.
#
# --- Production (Hetzner Object Storage) — ALL REQUIRED, config/settings.py's defaults are dev-only ---
# The bucket name becomes a DNS label (https://<bucket>.<loc>.your-objectstorage.com), so it must be
# lowercase and MUST NOT CONTAIN DOTS — a dot breaks TLS against Hetzner's wildcard certificate.
# S3_BUCKET=
# S3_LOCATION=fsn1                # fsn1 Falkenstein / nbg1 Nuremberg / hel1 Helsinki
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Leave S3_ENDPOINT_URL/S3_ADDRESSING_STYLE unset in production — they default to Hetzner's
# virtual-hosted-style endpoint derived from S3_LOCATION (config/settings.py checks DEBUG, and
# DJANGO_DEBUG=0 is a required prod setting above, so the MinIO defaults never apply there).
#
# The two AWS_* flags below are also already defaulted (config/settings.py sets them with
# os.environ.setdefault, since botocore reads them from the environment directly, not through
# Django) — uncomment only if a real deploy ever needs something other than "when_required".
# botocore >= 1.36 defaults to sending x-amz-checksum-crc32 with aws-chunked framing on every PUT,
# which S3-compatible providers including Hetzner mis-store or reject. The symptom is nasty: the
# upload returns 200 and the stored object contains the chunk framing, or you get
# XAmzContentSHA256Mismatch. Verify with one real upload the first time a new bucket is wired up.
# AWS_REQUEST_CHECKSUM_CALCULATION=when_required
# AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
