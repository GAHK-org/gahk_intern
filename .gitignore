legacy_site/*
gahk_dk.sql

# Python / Django
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
app/.env
# Every local SQLite DB, not just app/db.sqlite3: `task test:sqlite` writes app/test-db.sqlite3, and
# any DATABASE_URL=sqlite:///… override drops a file next to manage.py. They hold real dev/test data.
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
# The Beat scheduler now stores its state in PostgreSQL through django-celery-beat.
app/celerybeat-schedule*
app/staticfiles/
app/static/dist/
frontend/node_modules/

*.sql
# pg_dump custom-format output (gahk-clean.dump) — the whole clean DB, real resident data.
*.dump

CUTOVER.md

# ---------------------------------------------------------------------------
# Secrets and data. Added 2026-08-04 after a production database dump reached a
# public commit; every pattern below closes a gap that was live at that moment.
# ---------------------------------------------------------------------------

# `app/.env` matches that one path literally — it does NOT cover `.env.prod`, which DEPLOY.md §2
# designates for the full production secret set.
.env
.env.*
!.env.example

# Compressed dumps: `*.sql` / `*.dump` miss these entirely.
*.sql.gz
*.sql.bz2
*.dump.gz
*.tar.gz

# A missing colon turns `scp file root@host:~/` into a LOCAL copy named `root@host` — no extension,
# so no content-based rule catches it. That is exactly how the 3.7 MB production dump (117 unsalted
# password hashes, 1 861 applicant records) became public on 2026-08-04.
root@*
*@*.*.*.*
ubuntu-gahk*

# Key, certificate and ACME material
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
acme.json

# MEDIA_ROOT — resident-uploaded files, not source. Room-inspection photos (F-005) show the inside
# of named people's rooms, and Den Hurtige attachments are whatever someone photographed just now.
# In production these live on the server's volume; in dev they are a by-product of testing.
# NB: this stops NEW files being picked up. The legacy room photos already committed under
# app/media/public/image/intern/roomimages/ stay tracked until they are explicitly removed — and
# they remain in history either way, so removing them is the same job as the 2026-08-04 dump.
app/media/
/.vscode
.DS_Store
