# Dev-only image for `docker compose --profile docker up web` (hot-reload). NOT used in production —
# see Dockerfile for that. Installs dependencies (incl. the dev group) once at build time; app/ is
# bind-mounted at runtime (docker-compose.yml) so host edits reach uvicorn's --reload without a
# rebuild. No frontend build/collectstatic step: DEBUG=1 serves STATICFILES_DIRS directly, so the
# same `app/static/dist` a host-run `task frontend:build`/`frontend:watch` produces is picked up
# through the bind mount.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /bin/
# exiv2 (the photo album's metadata copying) links against the system's Expat XML parser, which the
# slim image leaves out.
RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 && rm -rf /var/lib/apt/lists/*
# /src, NOT /app: the bind mount replaces /app wholesale, and a .venv installed under it would be
# shadowed by the host's app/ directory (which has no .venv) the moment the container starts.
WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --python /usr/local/bin/python
ENV PATH="/src/.venv/bin:$PATH"
WORKDIR /src/app
# A host edit reaches the container through the bind mount without a file event, so --reload has to
# poll for it, as runserver did. Without this a change is never picked up.
ENV WATCHFILES_FORCE_POLLING=true
EXPOSE 8000
CMD ["sh", "-c", "python manage.py check && exec uvicorn config.asgi:application --host 0.0.0.0 --port 8000 --lifespan off --reload --reload-include '*.html'"]

