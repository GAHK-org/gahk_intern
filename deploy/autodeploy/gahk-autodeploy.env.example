# Copy to /etc/gahk-autodeploy.env (chmod 600, owned by root) — see DEPLOY.md §4a.

# Coolify → Keys & Tokens → API tokens, with the "deploy" permission only. Lives on the server
# alone; nothing in GitHub can use it.
COOLIFY_TOKEN=
# The app's resource UUID: the last segment of its URL in the Coolify dashboard.
COOLIFY_APP_UUID=

# Defaults, for reference:
# COOLIFY_URL=http://localhost:8000
# IMAGE=ghcr.io/gahk-org/gahk_intern:main
